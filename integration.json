            "repo"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
            "namespace",
            "repo"
          ],
          "query": {},
          "body": {}
        },
        "sampleArguments": {
          "namespace": "cornell-movie-review-data",
          "repo": "rotten_tomatoes"
        },
        "provenance": [
          "https://huggingface.co/.well-known/openapi.json"
        ]
      }
