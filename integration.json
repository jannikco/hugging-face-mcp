    "description": "Inspect Hub repository release references and model commit history. This is a Hub metadata connector, not an inference or model download service.",
    "tools": [
      {
        "name": "list_model_refs",
        "description": "Inspect model branches and tags before selecting a reproducible revision.",
        "method": "GET",
        "path": "/api/models/{namespace}/{repo}/refs",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            }
          },
          "required": [
            "namespace",
            "repo"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
            "namespace",
            "repo"
          ],
          "query": {},
          "body": {}
        },
        "sampleArguments": {
          "namespace": "openai",
          "repo": "whisper-tiny"
        },
        "provenance": [
          "https://huggingface.co/.well-known/openapi.json"
        ]
      },
      {
        "name": "list_model_commits",
        "description": "Inspect model commit metadata for a specified branch, tag or commit.",
        "method": "GET",
        "path": "/api/models/{namespace}/{repo}/commits/{rev}",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "rev": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "namespace",
            "repo",
            "rev"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
            "namespace",
            "repo",
            "rev"
          ],
          "query": {},
          "body": {}
        },
        "sampleArguments": {
          "namespace": "openai",
          "repo": "whisper-tiny",
          "rev": "main"
        },
        "provenance": [
          "https://huggingface.co/.well-known/openapi.json"
        ]
      },
      {
        "name": "list_dataset_refs",
        "description": "Inspect dataset branches and tags without downloading dataset contents.",
        "method": "GET",
        "path": "/api/datasets/{namespace}/{repo}/refs",
